<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Suite">

    <listeners>
        <listener class-name="framework.listeners.TestListener"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="ui.tests.SmokeTest"/>
            <class name="ui.tests.LoginTests"/>
            <class name="ui.tests.AdvancedLoginTests"/>
            <class name="ui.tests.InventoryTests"/>
            <class name="ui.tests.SortingTests"/>
            <class name="ui.tests.CartTests"/>
            <class name="ui.tests.CartAdvancedTests"/>
            <class name="ui.tests.LogoutTests"/>
            <class name="ui.tests.CheckoutTests"/>
        </classes>
    </test>
</suite>